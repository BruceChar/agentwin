# ================= LLM (pi-ai SDK) =================
# pi-ai supports: deepseek | openai | anthropic | google | moonshot | qwen | openrouter ...
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ================= Binance =================
# 公开行情（kline/ticker/WS）不需要 key；key 仅用于私有只读接口（账户信息等）。
# 本系统从不向 Binance 下真实订单（paper trading 是本地模拟账户）。
# 注意：真实 Key 只填在 .env（已 gitignore），不要提交到仓库！
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=false

# 行情实现选择：native（默认，自研轻量客户端 + 多主机回退）| official（官方连接器 @binance/spot，basePath 回退）
BINANCE_PROVIDER=native

# 国内网络 api.binance.com 常被 DNS 污染/拦截：系统会自动回退到官方公共行情端点
# data-api.binance.vision（现货 REST）与 data-stream.binance.vision（现货 WS），无需配置。
# 如需手动指定端点（例如走代理/镜像），取消注释并填值：
# BINANCE_SPOT_BASE_URL=https://api.binance.com
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_DATA_API_BASE_URL=https://data-api.binance.vision
# BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# ================= 本地数据库 =================
# 适配层支持: sqlite (默认, 零依赖) | duckdb | postgres (后续按需实现)
DB_ENGINE=sqlite
DB_PATH=./data/agentwin.db

# ================= Paper Trading（模拟账户） =================
PAPER_INITIAL_BALANCE_USDT=10000
PAPER_TAKER_FEE_RATE=0.001
PAPER_MAKER_FEE_RATE=0.0008
PAPER_SLIPPAGE_BPS=2

# ================= API =================
API_HOST=127.0.0.1
API_PORT=3000

# ================= Web =================
VITE_API_BASE=http://127.0.0.1:3000/api
